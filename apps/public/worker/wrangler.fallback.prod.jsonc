{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  // Production read-only fallback: answers the public GET routes from D1 when the primary API is down.
  "name": "write-project-public-fallback-prod",
  "main": "index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fallback-open-scripts.shawnup.com", "custom_domain": true }],
  "vars": {
    // Exact origins only.
    "ALLOWED_ORIGINS": "https://open-scripts.shawnup.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "write-project-public",
      "database_id": "fb59740e-2c40-4a3b-9dc6-12f5e21abe8d"
    }
  ]
}
