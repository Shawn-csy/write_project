{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "write-project-public-preview",
  "main": "index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // Preview only: forward to a running backend. Remove once the D1 binding below is in use.
    "BACKEND_ORIGIN": "https://open-scripts.shawnup.com",
    // Exact origins only: the dev site and the Pages preview URL.
    "ALLOWED_ORIGINS": "https://dev-open-scripts.shawnup.com,https://write-project-public-site-preview.pages.dev",
    // The dev site forwards to the live backend, so keep it from writing real counters and feedback.
    "READ_ONLY": "1"
  }
  // Fallback role: bind the D1 database holding the public_snapshot table.
  // While DB is bound the Worker answers from D1 and BACKEND_ORIGIN is ignored.
  // "d1_databases": [{ "binding": "DB", "database_name": "write-project-public", "database_id": "<id>" }]
}
