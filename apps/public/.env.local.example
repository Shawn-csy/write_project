# Backend API URL for server-side rendering.
# In Docker production, use http://write_project-backend:1091.
BACKEND_API_URL=http://localhost:1091

# Public base URL for metadataBase and canonical URLs
NEXT_PUBLIC_BASE_URL=https://open-scripts.shawnup.com

# Secret for on-demand ISR revalidation webhook
REVALIDATE_SECRET=change-me

# ── Static Pages build (npm run build:pages) ────────────────────────────────
# Primary API: the local backend behind the tunnel.
# NEXT_PUBLIC_API_ORIGIN=https://api.example.com
# Read-only fallback API (Worker + D1). Omit to build without failover.
# NEXT_PUBLIC_FALLBACK_API_ORIGIN=https://fallback.example.com
# Local media origin (defaults to the primary API) and its R2 fallback.
# NEXT_PUBLIC_MEDIA_ORIGIN=https://api.example.com
# NEXT_PUBLIC_MEDIA_FALLBACK_ORIGIN=https://media.example.com
# Where "進入工作室" points. Leave empty when the studio shares the site's origin.
# NEXT_PUBLIC_STUDIO_ORIGIN=https://studio.example.com
