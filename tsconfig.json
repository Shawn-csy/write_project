{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* 漸進式遷移：允許 JS 檔共存，但不強制 checkJs */
    "allowJs": true,
    "checkJs": false,

    /* 嚴格模式：漸進式 — 先關閉 noImplicitAny 讓遷移後的檔案通過，之後逐步補型別 */
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,

    /* 路徑 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* 輸出：Vite 處理，tsc 只做型別檢查 */
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
