{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* TS-only */
    "allowJs": false,
    "checkJs": false,

    /* 嚴格模式 */
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,

    /* 路徑 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@script-engine": ["./packages/script-engine/src/index.ts"],
      "@script-engine/*": ["./packages/script-engine/src/*"]
    },

    /* 輸出：Vite 處理，tsc 只做型別檢查 */
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "packages/script-engine/src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/test/**",
    "src/tests/**"
  ]
}
